{
  "mcpServers": {
    "todo-platform-docker": {
      "url": "http://localhost:3001/mcp"
    },
    "todo-platform-local": {
      "command": "node",
      "args": ["${workspaceFolder}/apps/mcp-server/dist/index.js"],
      "env": {
        "BACKEND_URL": "http://localhost:3000",
        "MCP_TRANSPORT": "stdio"
      }
    }
  }
}
