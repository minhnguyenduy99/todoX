{
  "mcpServers": {
    "todo-platform-docker-http": {
      "type": "streamableHttp",
      "url": "http://localhost:3001/mcp"
    },
    "todo-platform-local-stdio": {
      "command": "node",
      "args": ["${workspaceFolder}/apps/mcp-server/dist/index.js"],
      "env": {
        "BACKEND_URL": "http://localhost:10003",
        "MCP_TRANSPORT": "stdio"
      }
    }
  }
}
