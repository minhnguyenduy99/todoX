generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TodoStatus {
  NOT_STARTED
  IN_PROGRESS
  TESTING
  WAIT_FOR_STAGING
  COMPLETED
}

enum SubtaskStatus {
  NOT_STARTED
  IN_PROGRESS
  TESTING
  COMPLETED
  FAILED
}

enum MonitorType {
  http
  github_pr
  deployment
  testcase_scan
}

enum TestcaseScanStatus {
  scanning
  completed
  failed
}

enum DeployedEnvironmentName {
  dev
  uat
  uat_main
  staging
}

enum AssociatedTicketType {
  feature
  bug
}

enum ReleaseType {
  staging
  prod
}

enum ReleaseStatus {
  not_started
  in_progress
  successful
  partial_success
  failed
}

enum ReleaseDeploymentStatus {
  pending
  in_progress
  successful
  failed
}

model Todo {
  id                    String                  @id @default(uuid())
  title                 String
  description           String?
  status                TodoStatus              @default(NOT_STARTED)
  serviceId             String?                 @map("service_id")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  service               Service?                @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  releaseMemberships    ReleaseMember[]
  subtasks              Subtask[]
  monitor               Monitor?
  pullRequests          AssociatedPullRequest[]
  associatedTickets     AssociatedTicket[]
  deployedEnvironments  DeployedEnvironment[]
  testcaseScans         TestcaseScan[]

  @@index([serviceId])
  @@map("todos")
}

model TestcaseScan {
  id        String             @id @default(uuid())
  todoId    String             @map("todo_id")
  name      String
  status    TestcaseScanStatus @default(scanning)
  jobUrl    String?            @map("job_url")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  todo      Todo               @relation(fields: [todoId], references: [id], onDelete: Cascade)
  monitor   Monitor?

  @@index([todoId])
  @@map("testcase_scans")
}

model Subtask {
  id           String                  @id @default(uuid())
  todoId       String
  name         String
  status       SubtaskStatus           @default(NOT_STARTED)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  todo         Todo                    @relation(fields: [todoId], references: [id], onDelete: Cascade)
  monitor              Monitor?
  pullRequests         AssociatedPullRequest[]
  deployedEnvironments DeployedEnvironment[]

  @@index([todoId])
  @@map("subtasks")
}

model AssociatedPullRequest {
  id        String   @id @default(uuid())
  number    Int
  title     String
  status    String
  url       String
  todoId    String?
  subtaskId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  todo      Todo?    @relation(fields: [todoId], references: [id], onDelete: Cascade)
  subtask   Subtask? @relation(fields: [subtaskId], references: [id], onDelete: Cascade)

  @@index([todoId])
  @@index([subtaskId])
  @@map("associated_pull_requests")
}

model AssociatedTicket {
  id        String               @id @default(uuid())
  title     String
  type      AssociatedTicketType
  link      String
  todoId    String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  todo      Todo                 @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@index([todoId])
  @@map("associated_tickets")
}

model DeployedEnvironment {
  id        String                  @id @default(uuid())
  name      DeployedEnvironmentName
  todoId    String?
  subtaskId String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  todo      Todo?                   @relation(fields: [todoId], references: [id], onDelete: Cascade)
  subtask   Subtask?                @relation(fields: [subtaskId], references: [id], onDelete: Cascade)

  @@unique([todoId, name])
  @@unique([subtaskId, name])
  @@index([todoId])
  @@index([subtaskId])
  @@map("deployed_environments")
}

model Monitor {
  id                  String             @id @default(uuid())
  todoId              String?            @unique
  subtaskId           String?            @unique
  releaseDeploymentId String?            @unique @map("release_deployment_id")
  testcaseScanId      String?            @unique @map("testcase_scan_id")
  type                MonitorType
  cron                String
  enabled             Boolean            @default(true)
  config              Json
  lastRunAt           DateTime?
  nextRunAt           DateTime?
  lastResult          Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  todo                Todo?              @relation(fields: [todoId], references: [id], onDelete: Cascade)
  subtask             Subtask?           @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  releaseDeployment   ReleaseDeployment? @relation(fields: [releaseDeploymentId], references: [id], onDelete: Cascade)
  testcaseScan        TestcaseScan?      @relation(fields: [testcaseScanId], references: [id], onDelete: Cascade)

  @@map("monitors")
}

model Service {
  id                 String              @id @default(uuid())
  keyName            String              @unique @map("key_name")
  displayName        String?             @map("display_name")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  todos              Todo[]
  completedTodos     CompletedTodo[]
  releaseDeployments ReleaseDeployment[]

  @@map("services")
}

model Release {
  id             String              @id @default(uuid())
  releaseDate    String              @map("release_date")
  content        String
  type           ReleaseType
  status         ReleaseStatus       @default(not_started)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  members        ReleaseMember[]
  deployments    ReleaseDeployment[]
  completedTodos CompletedTodo[]

  @@index([releaseDate])
  @@map("releases")
}

model ReleaseMember {
  id        String   @id @default(uuid())
  releaseId String   @map("release_id")
  todoId    String   @map("todo_id")
  createdAt DateTime @default(now())
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@unique([releaseId, todoId])
  @@index([todoId])
  @@map("release_members")
}

model ReleaseDeployment {
  id          String                  @id @default(uuid())
  releaseId   String                  @map("release_id")
  serviceId   String                  @map("service_id")
  environment ReleaseType
  jobUrl      String?                 @map("job_url")
  buildNumber Int?                    @map("build_number")
  status      ReleaseDeploymentStatus @default(pending)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  release     Release                 @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  service     Service                 @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  monitor     Monitor?

  @@unique([releaseId, serviceId])
  @@index([serviceId])
  @@map("release_deployments")
}

model CompletedTodo {
  id                 String    @id @default(uuid())
  originalTodoId     String    @map("original_todo_id")
  releaseId          String    @map("release_id")
  title              String
  description        String?
  status             TodoStatus
  serviceId          String?   @map("service_id")
  associatedTickets  Json      @default("[]") @map("associated_tickets")
  pullRequests       Json      @default("[]") @map("pull_requests")
  archivedAt         DateTime  @default(now()) @map("archived_at")
  createdAt          DateTime
  updatedAt          DateTime
  release            Release   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  service            Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([releaseId])
  @@index([originalTodoId])
  @@index([serviceId])
  @@map("completed_todos")
}
