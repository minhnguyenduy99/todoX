generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TodoStatus {
  NOT_STARTED
  IN_PROGRESS
  TESTING
  WAIT_FOR_STAGING
  COMPLETED
}

enum SubtaskStatus {
  NOT_STARTED
  IN_PROGRESS
  TESTING
  COMPLETED
  FAILED
}

enum MonitorType {
  http
  github_pr
  deployment
}

enum DeployedEnvironmentName {
  dev
  uat
  uat_main
  staging
}

model Todo {
  id           String                  @id @default(uuid())
  title        String
  description  String?
  status       TodoStatus              @default(NOT_STARTED)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  subtasks             Subtask[]
  pullRequests         AssociatedPullRequest[]
  deployedEnvironments DeployedEnvironment[]

  @@map("todos")
}

model Subtask {
  id           String                  @id @default(uuid())
  todoId       String
  name         String
  status       SubtaskStatus           @default(NOT_STARTED)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  todo         Todo                    @relation(fields: [todoId], references: [id], onDelete: Cascade)
  monitor              Monitor?
  pullRequests         AssociatedPullRequest[]
  deployedEnvironments DeployedEnvironment[]

  @@index([todoId])
  @@map("subtasks")
}

model AssociatedPullRequest {
  id        String   @id @default(uuid())
  number    Int
  title     String
  status    String
  url       String
  todoId    String?
  subtaskId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  todo      Todo?    @relation(fields: [todoId], references: [id], onDelete: Cascade)
  subtask   Subtask? @relation(fields: [subtaskId], references: [id], onDelete: Cascade)

  @@index([todoId])
  @@index([subtaskId])
  @@map("associated_pull_requests")
}

model DeployedEnvironment {
  id        String                  @id @default(uuid())
  name      DeployedEnvironmentName
  todoId    String?
  subtaskId String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  todo      Todo?                   @relation(fields: [todoId], references: [id], onDelete: Cascade)
  subtask   Subtask?                @relation(fields: [subtaskId], references: [id], onDelete: Cascade)

  @@unique([todoId, name])
  @@unique([subtaskId, name])
  @@index([todoId])
  @@index([subtaskId])
  @@map("deployed_environments")
}

model Monitor {
  id         String      @id @default(uuid())
  subtaskId  String      @unique
  type       MonitorType
  cron       String
  enabled    Boolean     @default(true)
  config     Json
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  lastResult Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  subtask    Subtask     @relation(fields: [subtaskId], references: [id], onDelete: Cascade)

  @@map("monitors")
}
